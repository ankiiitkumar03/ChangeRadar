# Required for local signup and database-backed features.
# Get a PostgreSQL connection URL from your database provider.
DATABASE_URL=postgres://user:password@host:5432/changeradar
# Generate a random secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Required for scheduled monitoring (not needed for manual Check now).
# Generate a separate random secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Optional email alerts and password reset (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional AI summaries (OpenAI-compatible endpoint).
ZAI_API_KEY=
ZAI_API_BASE=
ZAI_MODEL=glm-4-flash

# Optional Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that receive admin access.
ADMIN_EMAILS=

# Optional Razorpay subscriptions. Configure all six together to enable paid checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
